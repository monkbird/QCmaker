OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3
TAVILY_API_KEY=
MAX_BUDGET_USD=1000.0
LLM_MAX_OUTPUT_TOKENS=2048
UNKNOWN_MODEL_RESERVE_USD=0.25
CORS_ORIGINS=http://localhost:5173
DATASET_TTL_HOURS=24
PPT_TTL_DAYS=7
# ---- 安全配置（可选）----
# 设置后所有 /api 接口与 WebSocket 需携带访问令牌（HTTP 头 x-api-token 或 ?token=）
API_ACCESS_TOKEN=
# 每 IP 每分钟请求上限（0 表示不限制）
RATE_LIMIT_PER_MINUTE=120

# ---- 管理控制台（独立账号，默认关闭）----
ADMIN_ENABLED=false
# 仅空数据库首次初始化使用；后续改密以数据库为准
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_CSRF_TOKEN_TTL_MINUTES=120
ADMIN_LOGIN_RATE_PER_MINUTE=5
ADMIN_MAX_SESSIONS=20
# 空值不增加 IP 白名单；反向代理必须正确配置可信来源
ADMIN_ALLOWED_IPS=
# HTTP 开发例外仅用于本机；生产使用 HTTPS
ENVIRONMENT=production
